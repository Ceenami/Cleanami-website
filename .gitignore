# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets. .env.example is the only tracked env file.
.env
.env.*
!.env.example

# private audit / handoff notes — never commit (enumerates live security holes)
_audit-private/

# client-facing briefing & proposal docs — keep out of the client's code repo
_client-docs/

# local-only agent memory pointer (imports AGENTS.md). Kept out of the remote so no
# Claude/Anthropic-named file appears in the client's repo.
CLAUDE.md

# internal operating guide for agents/humans — kept local, out of the client's repo.
AGENTS.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

