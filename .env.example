NEXT_PUBLIC_SUPABASE_URL=https://yoursupabaseurl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon_key
SUPABASE_SERVICE_ROLE_KEY=service_role_key
DATABASE_URL="postgresql://postgres.e9uenf9u3enf9fu:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres"

# Google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=secret_key

# Stripe — secret and publishable keys must both be test OR both be live
STRIPE_MODE=test
NEXT_PUBLIC_STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_key
STRIPE_SECRET_KEY_LIVE=sk_live_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_key
STRIPE_WEBHOOK_SECRET=webhook_key


# cron job for iCal sync
CRON_SECRET=create_your_secret_key

# api key for complete andcapture
CLEANER_APP_API_KEY=create_your_api_key

RESEND_API_KEY=re_xxxxxxxxxxxxx
NEXT_PUBLIC_APP_URL=https://cleannami.com

# SMS (Twilio) — optional; time-critical alerts no-op if unset
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15005550006

# Web Push (VAPID) — optional; push no-ops if unset.
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:booking@cleanami.ceenami.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key