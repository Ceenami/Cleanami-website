NEXT_PUBLIC_SUPABASE_URL=https://yoursupabaseurl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon_key
SUPABASE_SERVICE_ROLE_KEY=service_role_key
DATABASE_URL="postgresql://postgres.e9uenf9u3enf9fu:[PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres"

# Google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=secret_key

# Stripe — secret and publishable keys must both be test OR both be live
STRIPE_MODE=test
NEXT_PUBLIC_STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_key
STRIPE_SECRET_KEY_LIVE=sk_live_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_key
STRIPE_WEBHOOK_SECRET=webhook_key


# cron job for iCal sync
CRON_SECRET=create_your_secret_key

# api key for complete andcapture
CLEANER_APP_API_KEY=create_your_api_key

RESEND_API_KEY=re_xxxxxxxxxxxxx
NEXT_PUBLIC_APP_URL=https://cleannami.com
# Prepare only: enable redirects after DNS/TLS, Auth callbacks and provider URLs are verified.
CANONICAL_DOMAIN_REDIRECTS_ENABLED=false
CANONICAL_SITE_URL=https://cleannami.com
LEGACY_SITE_HOSTS=cleannami.ceenami.com,cleanami.ceenami.com
# Exact production hosts; previews/test hosts must not load live conversion tags.
NEXT_PUBLIC_TRACKING_HOSTS=cleannami.ceenami.com,cleannami.com,www.cleannami.com

# Owner-applied SQL0064 and existing Before infrastructure must be verified first.
BEFORE_REQUIRED_SCHEMA_READY=false
BEFORE_REQUIRED_ENROLLMENT=false
# Sunday 18:00–19:00 ET grace, then one initial catch-up per displayed 14-day block.
AVAILABILITY_GRACE_ENABLED=false
# SQL0065; new paid terms only. Requires the minimum schema/enrollment too.
SUBSCRIPTION_TERM_SCHEMA_READY=false
SUBSCRIPTION_TERM_ENROLLMENT=false
SUBSCRIPTION_TERM_WORKER_ENABLED=false
# SQL0066 must be present before enabling payment/payout/webhook recovery.
MONEY_RECOVERY_SCHEMA_READY=false
# UTC instant AFTER old payout workers have stopped. Earlier pending pay needs reconciliation.
PAYOUT_TRANSFER_ROLLOUT_AT=

# Prospective rental credit + separate late fees (owner applies SQL0067 first).
# Keep readiness/compatible code after enrollment; stop new purchases via ENROLLMENT.
RENTAL_FINANCE_SCHEMA_READY=false
RENTAL_FINANCE_ENROLLMENT=false
RENTAL_FINANCE_WORKER_ENABLED=false

# SMS (Twilio) — optional; time-critical alerts no-op if unset
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15005550006
# Advanced Opt-Out: configure STOP/START/HELP and this incoming POST webhook.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxx
TWILIO_INCOMING_WEBHOOK_URL=https://cleannami.com/api/twilio/incoming
# SQL0069 completes assignment timing/priority exceptions for prospectively
# recorded policies. Keep readiness after enrollment; stop new cohorts via ENROLLMENT.
ASSIGNMENT_EXCEPTIONS_SCHEMA_READY=false
ASSIGNMENT_EXCEPTIONS_ENROLLMENT=false

# Admin/operations SMS: recipient stays EMPTY until the client supplies it.
# Owner applies SQL0068/0061 and verifies sender/callbacks before enabling.
# ENABLED is explicit application opt-in; carrier START does not enable it.
ADMIN_SMS_TO=
ADMIN_SMS_ENABLED=false
ADMIN_SMS_SCHEMA_READY=false
ADMIN_SMS_ENVIRONMENT=production
# Required phone allowlist when ADMIN_SMS_ENVIRONMENT=test (E.164, comma-separated).
ADMIN_SMS_TEST_RECIPIENTS=

# Web Push (VAPID) — optional; push no-ops if unset.
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:booking@cleanami.ceenami.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
